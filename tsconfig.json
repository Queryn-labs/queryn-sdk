{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@queryn/plugin-sdk": ["src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "templates/**/*.ts"]
}
